{
  "mcpServers": {
    "blender": {
      "command": "python3",
      "args": ["server/blender_mcp_guided.py"],
      "env": {}
    },
    "blender-power": {
      "command": "python3",
      "args": ["server/blender_mcp_server.py"],
      "env": {}
    },
    "blender-2": {
      "command": "python3",
      "args": ["server/blender_mcp_guided.py"],
      "env": {
        "BLENDER_PORT": "9877",
        "OPENCLAW_PORT": "9877"
      }
    },
    "blender-3": {
      "command": "python3",
      "args": ["server/blender_mcp_guided.py"],
      "env": {
        "BLENDER_PORT": "9878",
        "OPENCLAW_PORT": "9878"
      }
    }
  }
}
